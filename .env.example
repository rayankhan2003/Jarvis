# Copy to .env and fill in. All keys are free and need no credit card.
# You need at least one brain key, plus GROQ_API_KEY for speech-to-text.

# Brain #1 (main): https://console.mistral.ai/api-keys  (choose the free "Experiment" plan)
# ~1 billion tokens a month free. Note: free-plan requests may be used to train Mistral's models.
MISTRAL_API_KEY=
# Models must work on your plan: `jarvis doctor` tests both. On the free plan
# mistral-large-latest is not available; the ministral models are.
MISTRAL_MODEL=ministral-8b-latest
# Used automatically for multi-step or "thinking" requests (plan, compare, write...).
# Set it to the same as MISTRAL_MODEL to always use one model.
MISTRAL_COMPLEX_MODEL=ministral-14b-latest

# Order to try brains in; providers without a key are skipped.
JARVIS_BRAIN_ORDER=mistral,groq,gemini,ollama

# Brain #3: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free tier: Flash-Lite models give the most requests per day. `jarvis doctor`
# tells you if this model isn't available to your key and suggests one that is.
GEMINI_MODEL=gemini-3.1-flash-lite

# Brain #2 and speech-to-text: https://console.groq.com/keys
GROQ_API_KEY=
# The big brain: hard questions ("explain", "compare", "plan", "should I...") go here.
GROQ_LLM_MODEL=openai/gpt-oss-120b
# How long it thinks before answering: low (fastest), medium, high
GROQ_REASONING=low
# 0 = never switch to the big brain for complex requests
JARVIS_SMART_BRAIN=1

# Optional offline brain (slow on 8 GB; used only when both clouds fail).
# Install Ollama, then: ollama pull qwen3.5:4b
OLLAMA_MODEL=

# Voice: run `jarvis voices` to hear them all. Best rated: af_heart (female, American),
# af_bella, bf_emma (female, British); male: am_michael, am_fenrir, bm_fable, bm_george
JARVIS_VOICE=af_heart

# About you
JARVIS_USER_NAME=
JARVIS_HONORIFIC=sir
# Used for "what's the weather?" and local questions
JARVIS_CITY=
# What "play some music" picks from, comma separated, e.g. Talha Anjum, Kaavish, lofi
JARVIS_MUSIC_TASTE=
# Browser for searches, sites and music when you don't name one, e.g. Brave
JARVIS_BROWSER=

# Wake word sensitivity (0-1, lower = triggers more easily) and how long Jarvis
# keeps listening after the conversation goes quiet.
JARVIS_WAKE_THRESHOLD=0.5
JARVIS_AWAKE_SECS=12

# How you talk to Jarvis: both (hold the key or say "Hey Jarvis"), key, or wake
JARVIS_TRIGGER=both
# Hold to talk: right_option, right_command, right_control, right_shift, f13, f14, f15
JARVIS_PTT_KEY=right_option
# The cursor buddy: a dot by your cursor that shows when Jarvis listens, thinks and talks,
# and flies to buttons when it points at something. 0 = off
JARVIS_BUDDY=1

# Seeing the screen ("what's on my screen?", "where's the export button?")
# Tried in this order; providers without a key or model are skipped.
JARVIS_VISION_ORDER=mistral,gemini,ollama
MISTRAL_VISION_MODEL=mistral-small-latest
# Local vision on a 16 GB+ Mac, e.g. qwen2.5vl:7b (ollama pull qwen2.5vl:7b)
OLLAMA_VISION_MODEL=

# 1 = skip the wake word and always listen (use headphones).
JARVIS_ALWAYS_LISTEN=0
# 1 = you can talk over Jarvis to interrupt it. Only with headphones: on laptop
# speakers the mic hears Jarvis and it cuts itself off after a word.
JARVIS_INTERRUPTIONS=0
# 1 = transcribe on the Mac with MLX Whisper instead of Groq (pip install -e ".[local-stt]").
JARVIS_LOCAL_STT=0
